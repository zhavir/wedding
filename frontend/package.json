{
  "name": "wedding-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node scripts/check-locales.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@sveltejs/adapter-static": ">=4.0.0",
    "@sveltejs/kit": ">=3.1.0",
    "@sveltejs/vite-plugin-svelte": ">=7.3.1",
    "@tailwindcss/vite": ">=4.3.3",
    "svelte": ">=5.57.2",
    "svelte-check": ">=4.7.7",
    "tailwindcss": ">=4.3.3",
    "typescript": ">=6.0.3",
    "vite": ">=8.3.4",
    "eslint": ">=10.13.0",
    "@eslint/js": ">=10.0.1",
    "typescript-eslint": ">=8.71.2",
    "eslint-plugin-svelte": ">=3.23.1",
    "globals": ">=17.13.0",
    "prettier": ">=3.9.10",
    "prettier-plugin-svelte": ">=4.1.1",
    "prettier-plugin-tailwindcss": ">=0.8.1",
    "@types/node": ">=26.6.5"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
