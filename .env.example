# Docker uses Floci for email and S3. No Resend key is needed locally.
# Production Resend setup: docs/EMAIL.md. Never commit API keys.
EMAIL_FROM=wedding@example.com
# Set your actual destination to enable notifications for new/changed RSVPs.
RSVP_NOTIFICATION_EMAIL=

# Optional locally; SST supplies the public LandingImages HTTPS URL in production.
PUBLIC_ASSET_URL=
